---
import InquiryEventFields from '../InquiryEventFields.astro';
import { inquiryLimits } from '../../lib/inquiry';

interface Offer {
  id: string;
  title: string;
}

interface Package {
  id: string;
  offerId: string;
  name: string;
}

interface InquiryConfig {
  apiUrl?: string;
  siteKey?: string;
  configured: boolean;
}

interface Props {
  isPreview: boolean;
  offers: Offer[];
  packages: Package[];
  inquiryConfig: InquiryConfig;
}

const { isPreview, offers, packages, inquiryConfig } = Astro.props;
---
<section class="demo-section demo-inquiry shell" id="anfrage" aria-labelledby="inquiry-title">
  <div class="demo-inquiry-intro">
    <p class="eyebrow">{isPreview ? 'Interaktive Auswahlvorschau' : 'Anfrage'}</p>
    <h2 id="inquiry-title">{isPreview ? 'Dein Event.' : 'Erzähl uns,'}<br /><em>{isPreview ? 'Deine Auswahl.' : 'was du vorhast.'}</em></h2>
    <p>
      {isPreview
        ? 'Wähle Produkt, Paket und Veranstaltungsdaten in vier Schritten. Der Versand ist noch nicht freigeschaltet.'
        : 'Mit wenigen Angaben können wir deinen Anlass, das gewünschte Erlebnis und den passenden Rahmen für die weitere Abstimmung einordnen.'}
    </p>
    <div class="demo-inquiry-shortcuts">
      <span>Produkt</span><span>Paket</span><span>Datum</span><span>Ort</span><span>Veranstaltung</span>
    </div>
  </div>

  {isPreview ? (
    <div class="inquiry-card demo-inquiry-card" data-demo-inquiry-disabled>
      <p class="eyebrow">Interaktive Vorschau</p>
      <h3>Dein Erlebnis zusammenstellen.</h3>
      <p>Produkt, Paket und Eventdaten kannst du jetzt im vierstufigen Konfigurator auswählen – ohne Anfrageversand.</p>
      <a class="button button-primary" href={(import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/') + 'demo/konfigurator/'}>Auswahl zusammenstellen <span aria-hidden="true">→</span></a>
      <p class="demo-form-legal">Die Anfrageübermittlung bleibt bis zur Betreiber- und Datenschutzfreigabe deaktiviert. Bitte keine Kontaktdaten eintragen. Eine Auswahl ist keine Buchung.</p>
    </div>
  ) : (
    <form
      class="inquiry-card demo-inquiry-card"
      aria-label="Anfrageformular"
      aria-busy="false"
      data-inquiry-form
      data-api-url={inquiryConfig.apiUrl}
      data-turnstile-site-key={inquiryConfig.siteKey}
    >
      <p class="demo-form-legal"><a href={(import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/') + 'anfrage/'}>Produkt und Paket zuerst im Konfigurator zusammenstellen →</a></p>
      <InquiryEventFields
        {offers}
        {packages}
        showStepLegends={true}
        emptyPackageLabel="Pakete folgen"
      />
      <fieldset class="inquiry-field-group inquiry-step">
        <legend><span aria-hidden="true">03</span> Kontaktdetails</legend>
        <div class="form-grid-two">
          <label>
            Name
            <input type="text" name="name" minlength="2" maxlength={inquiryLimits.name} autocomplete="name" required />
          </label>
          <label>
            E-Mail
            <input type="email" name="email" maxlength={inquiryLimits.email} autocomplete="email" required />
          </label>
        </div>
        <label>
          Telefonnummer <span class="optional">optional</span>
          <input type="tel" name="phone" maxlength={inquiryLimits.phone} autocomplete="tel" />
        </label>
        <label>
          Weitere Wünsche <span class="optional">optional</span>
          <textarea name="message" maxlength={inquiryLimits.message} rows="4" placeholder="Was sollen wir über dein Event noch wissen?"></textarea>
        </label>
      </fieldset>
      <label class="consent-row">
        <input type="checkbox" name="privacyConsent" value="true" required aria-describedby="privacy-note" />
        <span>Datenschutz-Einwilligung erforderlich.</span>
      </label>
      <p class="form-note" id="privacy-note">Der verbindliche Datenschutz- und Einwilligungstext wird vor der Produktionsaktivierung ergänzt.</p>
      <fieldset class="turnstile-field">
        <legend>Sicherheitsprüfung</legend>
        <div class="turnstile-wrap" data-turnstile-container tabindex="-1" aria-describedby="turnstile-help turnstile-status"></div>
        <p class="form-note" id="turnstile-help">Die Prüfung schützt das Formular vor automatisiertem Missbrauch.</p>
        <p class="turnstile-status" id="turnstile-status" data-turnstile-status aria-live="polite"></p>
      </fieldset>
      <div class="form-feedback">
        <p class="form-error" data-form-error role="alert" tabindex="-1" hidden></p>
        <p class="form-success" data-form-success role="status" aria-live="polite" aria-atomic="true" tabindex="-1" hidden></p>
      </div>
      <button type="submit" class="button button-primary demo-submit" disabled>
        <span data-submit-idle>Anfrage senden</span>
        <span data-submit-busy hidden>Anfrage wird gesendet …</span>
      </button>
      {!inquiryConfig.configured && (
        <p class="form-note config-note" role="status">Das Anfrageformular ist in diesem Build noch nicht für den Produktionsbetrieb konfiguriert.</p>
      )}
      <p class="demo-form-legal">Eine Anfrage ist keine Buchung und keine Verfügbarkeitsbestätigung.</p>
    </form>
  )}
</section>
